# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fotbollstipset

# NextAuth
# Generate: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# Azure AD (Entra ID) - register app at portal.azure.com
AZURE_AD_CLIENT_ID=your-azure-client-id
AZURE_AD_CLIENT_SECRET=your-azure-client-secret
AZURE_AD_TENANT_ID=your-azure-tenant-id
NEXTAUTH_URL=http://localhost:3000

# Football API (api-football.com)
FOOTBALL_API_KEY=your-api-football-key

# Cron job protection
# Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# App URL (used for internal API calls from server components)
APP_URL=http://localhost:3000
